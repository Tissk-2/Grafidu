# Koneksi Postgres self-hosted (server-only — tidak ada lagi env publik).
# Contoh VPS: postgres://grafidu_admin_root:SANDI@127.0.0.1:5432/grafidu_admin_database
DATABASE_URL=postgres://user:sandi@127.0.0.1:5432/grafidu

# 9Router (AI) — server-only, dipakai /api/ai/*.
# AI_ROUTER_URL: endpoint OpenAI-compatible dari 9router (jalankan `9router
# --host 127.0.0.1` — jangan pernah expose ke luar). Default sudah pas untuk
# VPS dan lokal karena router berjalan di mesin yang sama dengan aplikasi.
# AI_MODEL: id model dari `GET $AI_ROUTER_URL/models`. "First_combo" adalah
# combo bawaan dashboard 9router (rantai fallback antar provider); ganti ke id
# model tunggal (mis. kc/qwen/qwen3.8-27b:free) kalau mau menetap satu model.
# AI_ROUTER_KEY: API key dari dashboard 9router (menu API Keys) — endpoint
# menolak permintaan tanpa key.
AI_ROUTER_URL=http://127.0.0.1:20128/v1
AI_MODEL=First_combo
AI_ROUTER_KEY=sk-GANTI-DENGAN-KEY-DARI-DASHBOARD-9ROUTER
AI_TIMEOUT_MS=45000
